# Credenciales de Oracle Database 26ai (Base DB o Autonomous Database)
DB_USER=app_support
DB_PASSWORD=TuPasswordSeguro123!
DB_DSN=dbhost.sub04051019361.sarizavcn.oraclevcn.com:1521/pdblab1.sub04051019361.sarizavcn.oraclevcn.com

# Opcional: Si se utiliza Autonomous Database con mTLS (Wallet)
WALLET_DIR=
WALLET_PASSWORD=

# Motor de Inferencia LLM en CPU (Ollama en OCI Compute E6)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
